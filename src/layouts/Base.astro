---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { DEFAULT_LOCALE, HIDDEN_LOCALES, LOCALES, type Locale, pathOf } from "../i18n/locales.ts";
import { LANGUAGE_NAME, t } from "../i18n/ui.ts";
import { fingerprinted } from "../lib/fingerprint.ts";
import { fontsAskedFirst, hasSaiga } from "../lib/saiga.ts";
import { languageIntegrity, statusIntegrity, waitlistIntegrity } from "../lib/script-integrity.ts";
import { isSi } from "../lib/si.ts";

interface Props {
  slug: string;
  head: Record<Locale, { title: string; description: string }>;
  noindex?: boolean | undefined;
}
const { slug, head, noindex } = Astro.props;
const title = (locale: Locale) => (slug ? `${head[locale].title} · Kumpa` : head[locale].title);
const site = Astro.site ?? new URL("https://kumpa.fi");
const hasWaitlist = slug === "" || slug === "app";
// The /si/ copy (src/lib/si.ts): its style sheet reads the class and the page's name.
const si = isSi(Astro.url.pathname);
// HTML's `blocking="render"` on a script, which Astro's types do not name yet.
const holdsFirstPaint = { blocking: "render" };
// public/language.js reads each language's title and description from these.
const each = (value: (locale: Locale) => string) =>
  Object.fromEntries(LOCALES.map((locale) => [`data-${locale}`, value(locale)]));
---

<!doctype html>
<html lang="fi" class={si ? "si" : undefined} data-page={si ? slug || "home" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {fontsAskedFirst(si).map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <title {...each(title)}>{title(DEFAULT_LOCALE)}</title>
    <meta name="description" content={head[DEFAULT_LOCALE].description} {...each((locale) => head[locale].description)} />
    {noindex && <meta name="robots" content="noindex" />}
    {slug !== "404" && <link rel="canonical" href={new URL(pathOf("fi", slug), site).href} />}
    {hasSaiga() && <link rel="stylesheet" href="/fonts/saiga.css" />}
    <link rel="icon" type="image/png" sizes={si ? "392x392" : undefined} href={fingerprinted(si ? "/si-art/favicon.png" : "/favicon.png")} />
    {/* The snowflake again as lines: black, and white where the browser is dark (docs/decisions.md, 48). */}
    {si && <link rel="icon" type="image/svg+xml" sizes="any" href={fingerprinted("/si-art/favicon.svg")} />}
    {si && <link rel="apple-touch-icon" href={fingerprinted("/si-art/apple-touch-icon.png")} />}
    <meta name="theme-color" content={si ? "#fff6f0" : "#ffffff"} />
    <meta property="og:title" content={title("fi")} />
    <meta property="og:description" content={head.fi.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(fingerprinted(si ? "/si-art/share.png" : "/kuutti.png"), site).href} />
    <meta name="referrer" content={hasWaitlist ? "strict-origin" : "no-referrer"} />
    <script is:inline defer src={fingerprinted("/language.js")} integrity={languageIntegrity}></script>
    {(slug === "about" || slug === "about/details") && <script is:inline type="module" src={fingerprinted("/status.js")} integrity={statusIntegrity}></script>}
    {/* The waiting list's form is drawn once its script has chosen what to show: a page painted before that shows the address to write to, and then swaps it for the field (docs/decisions.md, 44). */}
    {hasWaitlist && <script is:inline type="module" {...holdsFirstPaint} src={fingerprinted("/waitlist.js")} integrity={waitlistIntegrity}></script>}
  </head>
  <body>
    {LOCALES.map(locale => <div data-lang={locale} lang={locale}><a class="skip" href="#content">{t(locale, "skip")}</a></div>)}
    {LOCALES.map(locale => <input class="visually-hidden" id={`lang-${locale}`} type="radio" name="language" value={locale} aria-label={LANGUAGE_NAME[locale]} lang={locale} checked={locale === DEFAULT_LOCALE} hidden={HIDDEN_LOCALES.has(locale)} autocomplete="off" />)}
    {LOCALES.map(locale => <div data-lang={locale} lang={locale}><Header locale={locale} slug={slug} /></div>)}
    <main id="content" tabindex="-1"><slot /></main>
    {LOCALES.map(locale => <div data-lang={locale} lang={locale}><Footer locale={locale} slug={slug}/></div>)}
  </body>
</html>
