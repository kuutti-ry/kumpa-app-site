---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { LOCALES, type Locale, pathOf } from "../i18n/locales.ts";
import { t } from "../i18n/ui.ts";
import { fingerprinted } from "../lib/fingerprint.ts";
import { hasSaiga } from "../lib/saiga.ts";
import { languageIntegrity, statusIntegrity } from "../lib/script-integrity.ts";

interface Props {
  slug: string;
  head: Record<Locale, { title: string; description: string }>;
  noindex?: boolean | undefined;
}
const { slug, head, noindex } = Astro.props;
const title = (locale: Locale) => (slug ? `${head[locale].title} · Kumpa` : head[locale].title);
const site = Astro.site ?? new URL("https://kumpa.fi");
---

<!doctype html>
<html lang="fi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-fi={title("fi")} data-en={title("en")}>{title("fi")}</title>
    <meta name="description" content={head.fi.description} data-fi={head.fi.description} data-en={head.en.description} />
    {noindex && <meta name="robots" content="noindex" />}
    {slug !== "404" && <link rel="canonical" href={new URL(pathOf("fi", slug), site).href} />}
    {hasSaiga() && <link rel="stylesheet" href="/fonts/saiga.css" />}
    <link rel="icon" type="image/png" href={fingerprinted("/favicon.png")} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title("fi")} />
    <meta property="og:description" content={head.fi.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(fingerprinted("/kuutti.png"), site).href} />
    <meta name="referrer" content="no-referrer" />
    <script is:inline defer src={fingerprinted("/language.js")} integrity={languageIntegrity}></script>
    {(slug === "about" || slug === "about/details") && <script is:inline type="module" src={fingerprinted("/status.js")} integrity={statusIntegrity}></script>}
  </head>
  <body>
    {LOCALES.map(locale => <div data-lang={locale} lang={locale}><a class="skip" href="#content">{t(locale, "skip")}</a></div>)}
    <input class="visually-hidden" id="lang-fi" type="radio" name="language" value="fi" aria-label="Suomi" lang="fi" checked autocomplete="off" />
    <input class="visually-hidden" id="lang-en" type="radio" name="language" value="en" aria-label="English" lang="en" autocomplete="off" />
    {LOCALES.map(locale => <div data-lang={locale} lang={locale}><Header locale={locale} slug={slug} /></div>)}
    <main id="content" tabindex="-1"><slot /></main>
    {LOCALES.map(locale => <div data-lang={locale} lang={locale}><Footer locale={locale} slug={slug}/></div>)}
  </body>
</html>
