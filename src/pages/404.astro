---
import { LOCALES, type Locale } from "../i18n/locales.ts";
import { t } from "../i18n/ui.ts";
import Base from "../layouts/Base.astro";

const info = (locale: Locale) => ({
  title: t(locale, "notFound.title"),
  description: t(locale, "notFound.body"),
});
---

<Base slug="404" head={{ fi: info("fi"), en: info("en") }} noindex>
  {LOCALES.map(locale => (
    <div data-lang={locale} lang={locale}>
      <section class="prose">
        <h1>{info(locale).title}</h1>
        <p>{info(locale).description}</p>
        <a href="/">{t(locale, "notFound.home")}</a>
      </section>
    </div>
  ))}
</Base>
