---
import type { Locale } from "../i18n/locales.ts";
import { SITE } from "../site.ts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const fi = locale === "fi";
const { apple, google } = SITE.stores;
---

{apple && google && (
  <ul class="stores" aria-label={fi ? "Sovelluskaupat" : "App stores"}>
    <li><a href={apple}><img src="/badges/app-store.svg" width="120" height="40" alt={fi ? "Lataa App Storesta" : "Download on the App Store"} /></a></li>
    <li><a href={google}><img src="/badges/google-play.png" height="40" alt={fi ? "Lataa Google Playsta" : "Get it on Google Play"} /></a></li>
  </ul>
)}
