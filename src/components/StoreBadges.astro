---
import type { Locale } from "../i18n/locales.ts";
import { t } from "../i18n/ui.ts";
import { SITE } from "../site.ts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { apple, google } = SITE.stores;
---

{apple && google && (
  <ul class="stores" aria-label={t(locale, "stores.label")}>
    <li><a href={apple}><img src="/badges/app-store.svg" width="120" height="40" alt={t(locale, "stores.apple")} /></a></li>
    <li><a href={google}><img src="/badges/google-play.png" height="40" alt={t(locale, "stores.google")} /></a></li>
  </ul>
)}
