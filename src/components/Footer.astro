---
import type { Locale } from "../i18n/locales.ts";
import { t } from "../i18n/ui.ts";
import { MARKS } from "../lib/marks.ts";
import { sectionAnchor } from "../lib/page-html.ts";
import { SITE } from "../site.ts";

interface Props {
  locale: Locale;
  slug?: string;
}

const { locale, slug } = Astro.props;
// Code from Finland has a badge in Finnish and one in English.
const fi = locale === "fi";
const contact = t(locale, "menu.contact");
const links = [
  ["legal/privacy", t(locale, "footer.privacy")],
  ["legal/terms", t(locale, "footer.terms")],
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <a class="brand" href="/">Kumpa</a>
    <nav class="footer-nav" aria-label={t(locale, "footer.label")}>
      <ul>
        <li>
          <a class="footer-contact-wide" href={`/about/#${sectionAnchor(locale, "contact")}`}>{contact}</a>
          <a class="footer-contact-compact" href="/about/contact/" aria-current={slug === "about/contact" ? "page" : undefined}>{contact}</a>
        </li>
        {links.map(([path, label]) => (
          <li><a href={`/${path}/`} aria-current={slug === path ? "page" : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="footer-end">
      <ul class="channels" aria-label={t(locale, "footer.channels")}>
        {SITE.social.map((channel) => (
          <li>
            <a href={channel.href} target="_blank" rel="noopener noreferrer" aria-label={channel.name}>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                <path d={MARKS[channel.mark]} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
      <a class="member-badge" href={fi ? "https://koodiasuomesta.fi/" : SITE.codeFromFinland} target="_blank" rel="noopener noreferrer">
        <img
          src={fi ? "/badges/koodia-suomesta-kumppanijasen.svg" : "/badges/code-from-finland-community-member.svg"}
          alt={t(locale, "footer.badge")}
          width="60"
          height="60"
        />
      </a>
    </div>
  </div>
</footer>
