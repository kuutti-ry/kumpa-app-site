---
// The pictures of the home and the app page (src/lib/si.ts): the shapes of
// Sini's design, toned down a little, as files of the site. Decoration only.
import { ART as art } from "../lib/si.ts";

interface Props {
  kind: "home" | "app";
}
const { kind } = Astro.props;
---

{kind === "home" ? (
  <div class="si-art si-art-home" aria-hidden="true">
    <img class="si-layer" src={`${art}/home-back.svg`} alt="" width="1066" height="948" />
    <img class="si-woman" src={`${art}/emma.webp`} alt="" width="1000" height="962" />
    <img class="si-man" src={`${art}/man.webp`} alt="" width="480" height="489" />
    <img class="si-layer" src={`${art}/home-front.svg`} alt="" width="1066" height="948" />
  </div>
) : (
  <div class="si-art si-art-app" aria-hidden="true">
    <img class="si-layer" src={`${art}/app-art.svg`} alt="" width="1026" height="1283" />
    <span class="si-word">Kumpa</span>
  </div>
)}
