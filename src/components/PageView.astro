---
import type { Locale } from "../i18n/locales.ts";
import { t } from "../i18n/ui.ts";
import type { Page } from "../lib/content.ts";
import { opened } from "../lib/home.ts";
import { pageHtml } from "../lib/page-html.ts";
import { stepped } from "../lib/si.ts";
import AboutCalm from "./AboutCalm.astro";
import PageBody from "./PageBody.astro";
import SiArt from "./SiArt.astro";
import StoreBadges from "./StoreBadges.astro";
import Waitlist from "./Waitlist.astro";

interface Props {
  locale: Locale;
  slug: string;
  page: Page;
}
const { locale, slug, page } = Astro.props;
// The app page and About Us have drawings of their own (src/lib/si.ts); About
// Us stands without the trail above it.
const siApp = slug === "app";
const siAbout = slug === "about";
const html = siApp ? stepped(pageHtml(page, locale)) : pageHtml(page, locale);
const home = slug === "";
const aboutChild = slug.startsWith("about/");
const appChild = ["help", "child-safety", "delete-account"].includes(slug);
const { opening, rest } = home ? opened(html) : { opening: "", rest: "" };
---

{!home && !siAbout && <nav class="breadcrumbs" aria-label={t(locale, "nav.breadcrumbs")}>
  <a href="/">{t(locale, "nav.home")}</a>
  {aboutChild && <><span aria-hidden="true"> / </span><a href="/about/">{t(locale, "nav.about")}</a></>}
  {appChild && <><span aria-hidden="true"> / </span><a href="/app/">{t(locale, "nav.app")}</a></>}
</nav>}
{home ? (
  <>
    {/* Sini's order (docs/decisions.md, 48): the picture under the name, and the
        way to the app before the waiting list. One order in the page and on the
        screen, so a keyboard and a screen reader go as the eye does. */}
    <section class="hero">
      <h1>{page.data.title}</h1>
      <SiArt kind="home" />
      <div class="hero-copy">
        <Fragment set:html={opening} />
        <a class="explore-app" href="/app/">{t(locale, "home.action")}</a>
        <Waitlist locale={locale} />
      </div>
    </section>
    {rest && <section class="prose" set:html={rest} />}
  </>
) : siAbout ? (
  <AboutCalm locale={locale} page={page} />
) : (
  <article class="prose">
    {siApp ? (
      // In the order it is read on a phone (docs/decisions.md, 50): the title,
      // the picture, then the waiting list. One order in the page and on the
      // screen; from 52rem a style stands the picture beside the other two.
      <div class="si-lead">
        <h1>{page.data.title}</h1>
        <SiArt kind="app" />
        <Waitlist locale={locale} />
      </div>
    ) : (
      <h1>{page.data.title}</h1>
    )}
    <PageBody html={html} locale={locale} />
    {siApp && <StoreBadges locale={locale} />}
  </article>
)}
