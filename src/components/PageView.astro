---
import { type Locale, pathOf } from "../i18n/locales.ts";
import { t } from "../i18n/ui.ts";
import { allPages, type Page } from "../lib/content.ts";
import { drawFlags } from "../lib/flag.ts";
import { opened } from "../lib/home.ts";
import { aboutSections } from "../lib/routes.ts";
import { drawTeam } from "../lib/team.ts";
import StoreBadges from "./StoreBadges.astro";

interface Props {
  locale: Locale;
  slug: string;
  page: Page;
}
const { locale, slug, page } = Astro.props;
if (!page.rendered) throw new Error(`${page.id} was not rendered`);
const html = drawTeam(drawFlags(page.rendered.html), locale)
  .replace(/\bid="([^"]+)"/g, (_, id) => `id="${locale}-${id}"`)
  .replace(/href="#([^"]+)"/g, (_, id) => `href="#${locale}-${id}"`);
const home = slug === "";
const aboutChild = slug.startsWith("about/");
const appChild = ["help", "child-safety", "delete-account"].includes(slug);
const sections = slug === "about" ? aboutSections.map((section) => `about/${section}`) : [];
const entries = sections.length ? await allPages() : [];
const links = sections.map((section) => {
  const entry = entries.find((candidate) => candidate.id === `${locale}/${section}`);
  if (!entry) throw new Error(`Missing section ${section} in ${locale}`);
  return { slug: section, ...entry.data };
});
const { opening, rest } = home ? opened(html) : { opening: "", rest: "" };
---

{!home && <nav class="breadcrumbs" aria-label={t(locale, "nav.breadcrumbs")}>
  <a href="/">{t(locale, "nav.home")}</a>
  {aboutChild && <><span aria-hidden="true"> / </span><a href="/about/">{t(locale, "nav.about")}</a></>}
  {appChild && <><span aria-hidden="true"> / </span><a href="/app/">{t(locale, "nav.app")}</a></>}
</nav>}
{home ? (
  <>
    <section class="hero">
      <div class="hero-copy">
        <h1>{page.data.title}</h1>
        <Fragment set:html={opening} />
        <a class="button-link" href="/app/">{t(locale, "home.action")}</a>
      </div>
      <div class="hero-art" aria-hidden="true"><img src="/logo.png" alt="" width="840" height="572" /></div>
    </section>
    {rest && <section class="prose" set:html={rest} />}
  </>
) : (
  <article class="prose">
    <h1>{page.data.title}</h1>
    <Fragment set:html={html} />
    {links.length > 0 && <ul class="page-links">
      {links.map(link => <li id={link.slug === "about/people" && locale === "fi" ? "who-we-are" : undefined}>
        <a href={pathOf(locale, link.slug)}><strong>{link.title}</strong><span>{link.description}</span></a>
      </li>)}
    </ul>}
    {slug === "app" && <StoreBadges locale={locale} />}
  </article>
)}
{page.data.machine && <p class="translation-note"><small>{t(locale, "notice.machine.title")}</small></p>}
