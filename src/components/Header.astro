---
import type { Locale } from "../i18n/locales.ts";
import { t } from "../i18n/ui.ts";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const fi = locale === "fi";
const groups = [
  {
    slug: "app",
    label: t(locale, "nav.app"),
    pages: [
      ["app", fi ? "Näin Kumpa toimii" : "How Kumpa works"],
      ["help", fi ? "Ohjeet" : "Help"],
      ["delete-account", fi ? "Tilin poistaminen" : "Delete your account"],
      ["child-safety", fi ? "Lasten turvallisuus" : "Child safety"],
    ],
  },
  {
    slug: "about",
    label: t(locale, "nav.about"),
    pages: [
      ["about", fi ? "Tietoa meistä" : "About us"],
      ["about/people", fi ? "Tekijät" : "People"],
      ["about/contact", fi ? "Ota yhteyttä" : "Contact"],
      ["about/details", fi ? "Tekniikka" : "Technical details"],
      ["about/media", fi ? "Medialle" : "For the media"],
    ],
  },
] as const;

const home = t(locale, "nav.home");
const brand = t(locale, "site.name");
const current = (page: string) => (page === slug ? "page" : undefined);
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label={`${brand} · ${home}`}>
      <img src="/logo.png" alt="" width="59" height="40" />
      <span>{brand}</span>
    </a>

    <nav class="site-nav site-wide" aria-label={t(locale, "nav.label")}>
      <ul>
        <li><a href="/" aria-current={current("")}>{home}</a></li>
        {
          groups.map((group) => (
            <li>
              <a
                href={`/${group.slug}/`}
                aria-current={current(group.slug) ?? (group.pages.some(([page]) => page === slug) ? "location" : undefined)}
              >
                {group.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="language-switch" role="group" aria-label={fi ? "Kieli" : "Language"}>
      <label for="lang-fi" lang="fi" title="Suomi">FI</label>
      <label for="lang-en" lang="en" title="English">EN</label>
    </div>

    <details class="site-menu">
      <summary>
        <svg class="open" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="close" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
        <span class="visually-hidden">{t(locale, "nav.menu")}</span>
      </summary>
      <nav class="site-nav" aria-label={t(locale, "nav.label")}>
        <ul>
          <li><a href="/" aria-current={current("")}>{home}</a></li>
          {
            groups.map((group) => (
              <li>
                <details class="menu-branch">
                  <summary>
                    {group.label}
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path d="m4 6 4 4 4-4" />
                    </svg>
                  </summary>
                  <ul>
                    {group.pages.map(([page, label]) => (
                      <li><a href={`/${page}/`} aria-current={current(page)}>{label}</a></li>
                    ))}
                  </ul>
                </details>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
