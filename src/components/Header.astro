---
import { LOCALES, type Locale } from "../i18n/locales.ts";
import { LANGUAGE_NAME, t } from "../i18n/ui.ts";
import { isSi } from "../lib/si.ts";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const groups = [
  {
    slug: "app",
    label: t(locale, "nav.app"),
    pages: [
      ["app", t(locale, "menu.app")],
      ["help", t(locale, "menu.help")],
      ["delete-account", t(locale, "menu.deleteAccount")],
      ["child-safety", t(locale, "menu.childSafety")],
    ],
  },
  {
    slug: "about",
    label: t(locale, "nav.about"),
    pages: [
      ["about", t(locale, "menu.about")],
      ["about/people", t(locale, "menu.people")],
      ["about/contact", t(locale, "menu.contact")],
      ["about/details", t(locale, "menu.details")],
      ["about/media", t(locale, "menu.media")],
    ],
  },
] as const;

const home = t(locale, "nav.home");
const brand = t(locale, "site.name");
// The /si/ copy wears the snowflake (docs/decisions.md, 46); the site keeps the seal.
const si = isSi(Astro.url.pathname);
const current = (page: string) => (page === slug ? "page" : undefined);
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label={`${brand} · ${home}`}>
      {si ? <img src="/si-art/mark.svg" alt="" width="40" height="40" /> : <img src="/logo.png" alt="" width="59" height="40" />}
      <span>{brand}</span>
    </a>

    <nav class="site-nav site-wide" aria-label={t(locale, "nav.label")}>
      <ul>
        <li><a href="/" aria-current={current("")}>{home}</a></li>
        {
          groups.map((group) => (
            <li>
              <a
                href={`/${group.slug}/`}
                aria-current={current(group.slug) ?? (group.pages.some(([page]) => page === slug) ? "location" : undefined)}
              >
                {group.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="language-switch" role="group" aria-label={t(locale, "nav.language")}>
      {LOCALES.map((language) => (
        <label for={`lang-${language}`} lang={language} title={LANGUAGE_NAME[language]}>{language.toUpperCase()}</label>
      ))}
    </div>

    <details class="site-menu">
      <summary>
        <svg class="open" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="close" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
        <span class="visually-hidden">{t(locale, "nav.menu")}</span>
      </summary>
      <nav class="site-nav" aria-label={t(locale, "nav.label")}>
        <ul>
          <li><a href="/" aria-current={current("")}>{home}</a></li>
          {
            groups.map((group) => (
              <li>
                <details class="menu-branch">
                  <summary>
                    {group.label}
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path d="m4 6 4 4 4-4" />
                    </svg>
                  </summary>
                  <ul>
                    {group.pages.map(([page, label]) => (
                      <li><a href={`/${page}/`} aria-current={current(page)}>{label}</a></li>
                    ))}
                  </ul>
                </details>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
