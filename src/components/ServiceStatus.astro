---
import type { Locale } from "../i18n/locales.ts";
import { t } from "../i18n/ui.ts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const unknown = t(locale, "status.unknownValue");
const unknownSummary = t(locale, "status.unknown");
---

<div class="service-status" data-service-status data-state="unknown">
  <p class="service-status-summary" role="status" aria-live="polite" aria-atomic="true">
    <span class="service-status-dot" aria-hidden="true"></span>
    <strong
      data-status-summary
      data-ok={t(locale, "status.ok")}
      data-degraded={t(locale, "status.degraded")}
      data-checking={t(locale, "status.checking")}
      data-unknown={unknownSummary}
    >{t(locale, "status.unchecked")}</strong>
  </p>
  <dl class="service-status-components">
    <div>
      <dt>{t(locale, "status.db")}</dt>
      <dd
        data-status-db
        data-state="unknown"
        data-ok={t(locale, "status.dbOk")}
        data-unreachable={t(locale, "status.dbUnreachable")}
        data-unknown={unknown}
      >{unknown}</dd>
    </div>
    <div>
      <dt>{t(locale, "status.migrations")}</dt>
      <dd
        data-status-migrations
        data-state="unknown"
        data-current={t(locale, "status.current")}
        data-pending={t(locale, "status.pending")}
        data-unknown={unknown}
      >{unknown}</dd>
    </div>
  </dl>
  <div class="service-status-foot">
    <small data-status-timestamp hidden>{t(locale, "status.checked")} <time data-status-checked></time></small>
    <div class="service-status-actions">
      <button type="button" data-status-refresh hidden>{t(locale, "status.refresh")}</button>
      <a href="https://api.kumpa.fi/health" target="_blank" rel="noopener noreferrer">{t(locale, "status.raw")}</a>
    </div>
  </div>
</div>
